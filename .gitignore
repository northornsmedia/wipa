# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.apk
supabase/.temp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# App bundles
*.aab
*.tmp

# Firebase Android configuration is installed locally during release builds
/android/app/google-services.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
scratch/
scripts/test_query.js
